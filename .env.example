# ============================================================
#  Kora — variables de entorno (ejemplo). Copia a .env.local para dev,
#  y configúralas en Vercel → Settings → Environment Variables (Production).
#  NUNCA comitees valores reales (.env.local está en .gitignore).
# ============================================================

# ── Supabase (OBLIGATORIAS) ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...                 # llave pública (anon)
SUPABASE_SERVICE_ROLE_KEY=eyJ...                     # service-role (SOLO server) — sin esto, nada funciona

# ── Sitio ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://kora-hotel.com          # base para URLs/snippet del motor

# ── Stripe (OBLIGATORIO para pagos) ──────────────────────────
STRIPE_SECRET_KEY=sk_live_...                        # o sk_test_... para pruebas
# Llave PÚBLICA (Dashboard → Developers → API keys → Publishable key). Habilita
# el pago EMBEBIDO de la suscripción (sin salir del sitio); si falta, el flujo
# cae al Checkout hospedado de Stripe (redirect). No es un secreto.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# DOS webhooks distintos = DOS secretos distintos (Stripe firma cada endpoint):
STRIPE_WEBHOOK_SECRET_RESERVAS=whsec_...             # endpoint /api/h/webhooks/stripe (RESERVAS, eventos de cuenta propia)
STRIPE_WEBHOOK_SECRET_RESERVAS_CONNECT=whsec_...     # MISMO endpoint pero registrado para "connected accounts" (direct charges + account.updated)
STRIPE_WEBHOOK_SECRET=whsec_...                      # endpoint /api/stripe/webhook (SUSCRIPCIONES)
# Precio del plan de suscripción (Stripe → Products → Prices):
# Se genera con: STRIPE_SECRET_KEY=sk_... node scripts/stripe-setup.mjs
STRIPE_PRICE_KORA=price_...        # plan Kora, todo incluido ($550 MXN/mes)
# Para que cada hotel cobre a su cuenta: habilitar Stripe Connect (Express) en el Dashboard.

# ── IA (asistente del admin) ─────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...                         # sin esto el asistente IA degrada con un mensaje amable

# ── Correos (Resend) ─────────────────────────────────────────
RESEND_API_KEY=re_...                                # sin esto NO se envían correos (degrada, no truena)
RESEND_FROM=Kora <hola@kora-hotel.com>               # remitente (dominio verificado en Resend)
NOTIFY_EMAIL=tucorreo@ejemplo.com                    # avisos internos

# ── Crons (Vercel Pro) ───────────────────────────────────────
CRON_SECRET=<openssl rand -hex 32>                   # protege /api/cron/* (ical-sync, email-sequences, digest, dunning, abandono)

# ── Facturación CFDI (Facturama) — opcional ──────────────────
FACTURAMA_USER=
FACTURAMA_PASSWORD=
# (las rutas de facturación degradan a 503 amable si faltan)

# ── CRM interno (opcional, separado del Auth de hoteles) ─────
CRM_PASSWORD=

# ── Bot de WhatsApp (Camila) ─────────────────────────────────
BOT_FLEET_SECRET=<openssl rand -hex 32>              # secreto de plataforma: /api/bots/fleet y /api/admin/bot-qr → runtime
CAMILA_RUNTIME_URL=https://camila-xxxx.up.railway.app # URL del runtime (Railway). Sin esto el panel muestra el QR como "sin servicio"

# ── Medición y anuncios ──────────────────────────────────────
# Faltaban en este archivo aunque SÍ están en Vercel producción, así que quien
# clonaba el repo se quedaba sin medición y sin saber que existían.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX                       # GA4 propio de Kora. Sin esto no se carga gtag: cero medición
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION=AW-XXXXXXX/xxxx    # conversión de Google Ads. Sin esto se paga publicidad sin medir qué convierte

# ── Contacto (público, se ve en el navegador) ────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=524891251458             # el WhatsApp que ven los visitantes del sitio
NEXT_PUBLIC_WHATSAPP_KORA=                           # opcional: un WhatsApp distinto para soporte. Si va vacío se usa el de arriba
NEXT_PUBLIC_FORMSPREE_URL=                           # opcional: copia de los leads a Formspree. Vacío = sólo se guardan en la base

# ── Facturación CFDI — el resto de la configuración ──────────
FACTURAMA_API_URL=https://apisandbox.facturama.mx    # sandbox o producción
FACTURAMA_SERIE=A
FACTURAMA_EXPEDITION_PLACE=79000                     # código postal del emisor
# ⚠️ Al 1 sep 2026 NINGUNA de las cinco FACTURAMA_* está en Vercel producción:
#    la facturación está escrita pero apagada, y las rutas devuelven 503.

# ── Blog automático ──────────────────────────────────────────
BLOG_AGENT_SECRET=<openssl rand -hex 32>             # autoriza a /api/blog/create. Lo usa el workflow de GitHub

# ── Camila: ajustes finos (opcionales) ───────────────────────
CAMILA_MODEL=                                        # vacío = el modelo por defecto del runtime
CHAT_TTL_MS=21600000                                 # 6 h: cuánto se conserva un chat sin actividad antes de purgarlo
