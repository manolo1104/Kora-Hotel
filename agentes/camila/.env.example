# ── Camila (runtime multi-tenant) — variables de entorno ─────────────────────

# Clave de Anthropic (Claude). Obligatoria.
ANTHROPIC_API_KEY=sk-ant-...

# De dónde saca la flota de hoteles. Apunta a tu Kora en producción.
KORA_BASE_URL=https://kora-hotel.com

# Secreto de plataforma para leer /api/bots/fleet. DEBE coincidir con el
# BOT_FLEET_SECRET configurado en Vercel (el proyecto Kora).
BOT_FLEET_SECRET=

# Modelo de Claude. Por defecto `claude-sonnet-5` (brain.js:15). Este archivo
# nombraba otro modelo, de una familia anterior, que no corre desde hace meses.
# Para bajar costo en volumen alto, `claude-haiku-4-5`.
# CAMILA_MODEL=claude-sonnet-5

# Fallback para pruebas LOCAL sin endpoint: lista de hoteles a mano (JSON).
# Si está presente, se usa en vez de /api/bots/fleet.
# KORA_FLEET=[{"slug":"paraiso","nombre":"Paraíso","token":"kora_xxx","lang":"es"}]

# Opcionales (tienen buen default). Están TODAS las que el código lee: antes
# aquí sólo salían 3 de las 15, así que una variable mal puesta en Railway no se
# notaba hasta que algo se comportaba raro sin explicación.
# PORT=3001                       # página de estado/QR + /health (Railway lo inyecta)
# WWEBJS_DATA_PATH=./.wwebjs_auth # 🔴 en Railway DEBE apuntar al volumen persistente.
#                                 # El default cae dentro de /app y se BORRA en cada
#                                 # deploy: los hoteles pedirían QR nuevo cada vez.
# MESSAGE_DEBOUNCE_MS=2500        # espera para agrupar mensajes seguidos
# FLEET_POLL_MS=300000            # cada cuánto se re-consulta la flota (5 min).
#                                 # También es cada cuánto se relee el token de un
#                                 # hotel ya arrancado, así que marca lo que tarda
#                                 # en surtir efecto una rotación de tokens.
# KORA_KNOWLEDGE_TTL_MS=900000    # cada cuánto refresca el conocimiento del hotel
# KORA_BOT_STATUS_TTL_MS=45000    # caché del on/off del bot; corta para que
#                                 # "apagar" desde el panel surta efecto en vivo
# CAMILA_MAX_TOKENS=1024
# CAMILA_MAX_HISTORY=20           # pares de turnos que recuerda por chat
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium  # lo fija el Dockerfile

# "Toma humana": pausar el bot en un chat cuando alguien del hotel responde a
# mano. 🔴 APAGADA por defecto y hay que activarla a propósito — con el formato
# @lid, whatsapp-web.js reporta mal `fromMe` en mensajes ENTRANTES y esto pausaba
# chats sin razón, dejando a Camila muda sin que nadie supiera por qué.
# CAMILA_HUMAN_TAKEOVER=1
# HUMAN_TAKEOVER_MS=3600000       # cuánto dura esa pausa (1 h)
