{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "regions": [
    "iad1"
  ],
  "crons": [
    {
      "path": "/api/cron/digest",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/dunning",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/cron/email-sequences",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/ical-sync",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/abandono",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/prueba",
      "schedule": "30 16 * * *"
    },
    {
      "path": "/api/cron/leads",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/suscriptores",
      "schedule": "30 17 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/((?!h/).*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/h/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
